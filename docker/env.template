# Secrets for this deployment. Never commit this file.
# Fine-grained PAT of the bot account: contents:read, pull-requests:write, metadata:read on the polled repos.
GH_TOKEN=
# Set to off to disable the egress allowlist (debugging only).
CRA_FIREWALL=on
# Discover pull requests that request this account's review: on or off (off: review only on request).
CRA_POLL=on
# How reviews post on GitHub: auto (approve or request changes per the verdict) or comment.
CRA_POSTING=auto
